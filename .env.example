# Host ports published by Docker Compose.
APP_PORT=3000
POSTGRES_PORT=5433
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CENTRIFUGO_PORT=8000

# Host development / Prisma connection; Compose overrides container addresses.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/multimedia
COOKIE_SECURE=false

# Replace localhost in public URLs with this PC's LAN IP for other devices.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=multimedia-assets
MINIO_ACCESS_KEY=amagi-local
MINIO_SECRET_KEY=replace-with-a-unique-random-secret

CENTRIFUGO_HTTP_URL=http://localhost:8000
CENTRIFUGO_PUBLIC_URL=ws://localhost:8000/connection/websocket
CENTRIFUGO_API_KEY=replace-with-a-unique-random-secret
CENTRIFUGO_TOKEN_SECRET=replace-with-a-unique-random-secret
