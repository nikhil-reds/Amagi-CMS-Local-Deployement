{
  "name": "amagi-screen-player",
  "productName": "Amagi Screen Player",
  "version": "1.0.0",
  "description": "Full-screen kiosk player that shows the content assigned to an Amagi Multimedia screen.",
  "main": "main.js",
  "private": true,
  "author": "Amagi",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never",
    "prestart": "node prepare-assets.cjs",
    "predist": "node prepare-assets.cjs"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.amagi.screenplayer",
    "productName": "Amagi Screen Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "player.html",
      "build-config.json",
      "icon.png",
      "package.json",
      "media-runtime.js",
      "pdfjs/**/*"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "portable",
      "artifactName": "AmagiScreenPlayer-${version}.exe"
    }
  },
  "dependencies": {
    "centrifuge": "^5.3.1"
  }
}
