// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SessionStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
}

enum DocumentStatus {
  PENDING
  UPLOADING
  UPLOADED
  FAILED
}

enum DocumentSourceType {
  FILE
  WEBSITE
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Session {
  id        String        @id @default(cuid())
  status    SessionStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  documents Document[]
}

model Document {
  id        String         @id @default(cuid())
  sessionId String

  // original asset metadata
  name      String
  size      Int
  mimeType  String

  sourceType DocumentSourceType @default(FILE)

  // MinIO/S3-compatible object location for uploaded files
  s3Bucket           String?
  s3Key              String?
  s3Url              String?

  // Legacy Cloudinary location retained during migration
  cloudinaryUrl      String?
  cloudinaryPublicId String?

  // External website asset location
  websiteUrl String?

  status    DocumentStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  screenAssets ScreenAsset[]
}

model Screen {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(5)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets ScreenAsset[]
}

model ScreenAsset {
  id         String   @id @default(cuid())
  screenId   String
  documentId String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  screen   Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([screenId])
  @@index([documentId])
}


// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  // scrypt hash, see lib/auth.ts
  passwordHash String
  role         UserRole  @default(EDITOR)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions UserSession[]
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored.
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
