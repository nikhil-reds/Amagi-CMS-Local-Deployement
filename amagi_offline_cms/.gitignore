# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# desktop (Electron) app
/desktop/node_modules
/desktop/dist

# local docker tar archives
*.tar
*.tar.gz
*.zip

# Generated media renderer dependencies
/public/pdfjs
/desktop/pdfjs
/desktop/centrifuge-client.cjs
/desktop/amagi-idle.jpg

# Font assets (binary, served via CDN or package manager)
/public/AbroSans
/public/Poppins

# Test output artifacts
/test-results
/android/.tools/
/android/.gradle/
/android/**/build/
/android/app/src/main/assets/
/android/app/src/main/res/drawable/xos_logo.png
/android/local.properties
/android/*.jks
/android/.signing/
/public/XOS-Android.apk
